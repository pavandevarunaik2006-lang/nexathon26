# RoadAlert Environment Configuration (.env.example)

# Server Configuration
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# Leave DATABASE_URL empty in local development without Docker to automatically use embedded PGlite PostgreSQL
# For managed PostgreSQL or Docker Compose, set a standard Postgres connection string:
# DATABASE_URL=postgresql://roadalert:roadalert_dev_password@localhost:5432/roadalert_db
DATABASE_URL=
PGLITE_DATA_DIR=./data/pglite

# Authentication & Security
JWT_ACCESS_SECRET=change_me_in_production_access_secret_32_chars_min
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret_32_chars_min
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# File Storage
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Routing & Map Integrations
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org

# Optional AI Integration
AI_PROVIDER=heuristic
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Variables (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
